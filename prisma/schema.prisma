// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TwoFactorType {
  APP
  EMAIL
  SMS
}

// ================= USER MODULE =================
model User {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  countryCode  String
  phone        String
  email        String @unique
  passwordHash String

  // Verification flags (0 / 1 / NULL)
  isPhoneVerified Int?
  isEmailVerified Int?

  lockStatus String

  whmcsClientId Int?
  ActiveStatus  Int @default(1)
  LastStatus    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  onboarding Onboarding?

  kycProfile KycProfile?
  twoFactorType TwoFactorType?
  sessions   Session[]

  verifications    VerificationDocument[]
  diditSessions    DiditSession[]
  kycRejections    KycRejection[]
  twoFactorMethods   TwoFactorMethod[]

  @@index([email])
  @@index([phone])
  @@index([whmcsClientId])
  @@index([ActiveStatus])
  @@index([createdAt])

  @@index([countryCode, phone])
  @@map("users")
}

// ================= SESSION MODULE =================
model Session {
  id          String   @id
  userId      Int
  refreshHash String
  ipAddress   String
  userAgent   String
  deviceName  String
  expiresAt   DateTime
  lastActivity DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ================= SUPER ADMIN MODULE =================
model SuperAdmin {
  id                 Int     @id @default(autoincrement())
  first_name         String
  last_name          String
  email              String  @unique
  mobile             String? @unique
  password           String
  role               Int
  status             Int @default(1)
  LastStatus         Int?
  two_factor_enabled Boolean @default(false)
  two_factor_secret  String?
  two_factor_configured Boolean @default(false)

  // Profile Fields
  gender        String?
  date_of_birth DateTime?
  country       String?
  state         String?
  city          String?
  postal_code   String?
  address       String?

  // System Fields
  last_login_at DateTime?
  last_login_ip String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  sessions    AdminSession[]
  permissions AdminPermission[]

  @@map("admin_management")
}

// ================= ADMIN ROLE MODULE =================
model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String   @db.Text // JSON: { "kyc": {view,create,edit,delete}, ... }
  is_system   Boolean  @default(false) // true = built-in, cannot be deleted
  created_at  DateTime @default(now())
  updated_at  DateTime?

  @@map("admin_roles")
}

// ================= ADMIN PERMISSION MODULE =================
model AdminPermission {
  id       Int    @id @default(autoincrement())
  adminId  Int
  module   String // e.g. "kyc", "users", "staff", "dashboard"
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)

  admin SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, module])
  @@index([adminId])
  @@index([module])
  @@map("admin_permissions")
}

// ================= ADMIN SESSION MODULE =================
model AdminSession {
  id          Int      @id @default(autoincrement())
  sessionId String @unique @default(cuid())
  adminId     Int
  refreshHash String
  ipAddress   String
  userAgent   String
  deviceName  String
  browser     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  admin SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ================= ONBOARDING MODULE =================
model Onboarding {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique
  userId        Int      @unique
  whmcsClientId Int?
  status        String   @default("pending") // pending | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([whmcsClientId])
  @@index([status])
  @@map("onboarding")
}

// ================= KYC REJECTION MODULE =================
model KycRejection {
  id         Int      @id @default(autoincrement())
  userId     Int
  reference  String?
  status     String
  rawResponse Json?
  verifiedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  verifications VerificationDocument[]


  @@map("kyc_rejections")
}

// ================= KYC PROFILE MODULE =================
model KycProfile {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique
  accountType String
  status      String @default("pending")

  currency String @default("INR")

  firstName String
  lastName  String
  email     String
  phone     String
  country   String

  state         String?
  city          String?
  postalCode    String?
  streetAddress String?

  // 0 = Aadhar Card, 1 = GST
  addressType Int @default(0)

  companyName  String?
  businessType String?

  panNumber String?
  gstNumber String?
  cinNumber String?

  gstVerified           Boolean @default(false)
  cinVerified           Boolean @default(false)
  aadharVerified        Boolean @default(false)
  panVerified           Boolean @default(false)
  internationalVerified Boolean @default(false)

  // Representative full name for non-Indian enterprise
  representativeName String?

  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications     VerificationDocument[]
  diditSessions     DiditSession[]
  businessDocuments BusinessDocument[]

  @@index([status])
  @@index([accountType])
  @@index([createdAt])
  @@map("kyc_profiles")
}

// ================= BUSINESS DOCUMENT MODULE =================
model BusinessDocument {
  id           Int      @id @default(autoincrement())
  kycProfileId Int
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  kycProfile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)

  @@map("business_documents")
}

// ================= VERIFICATION DOCUMENT MODULE =================
model VerificationDocument {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kycProfileId Int?
  kycProfile   KycProfile? @relation(fields: [kycProfileId], references: [id], onDelete: Cascade)

  kycRejectionId Int?
  kycRejection   KycRejection? @relation(fields: [kycRejectionId], references: [id], onDelete: Cascade)

  verificationType String // "digilocker" | "aadhaar" | "gst" | "cin" | "pan"
  documentNumber   String?

  cashfreeRefId      String? @unique
  verificationStatus String? // "success" | "failed" | "pending"

  extractedData Json?
  rawResponse   Json?
  
  verificationToken String?
  verificationTokenExpiresAt DateTime?

  attemptStatus String @default("pending") // pending | approved | rejected

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([kycProfileId])
  @@index([cashfreeRefId])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("verification_documents")
}

// ================= USER INVITATIONS MODULE =================
model UserInvitation {
  id            Int      @id @default(autoincrement())
  uuidToken     String   @unique
  whmcsClientId Int
  email         String
  permissions   String?  @db.Text
  acceptedAt    DateTime?
  updatedAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([whmcsClientId, email])
  @@map("user_invitations")
}

// ================= PASSWORD RESET MODULE =================
model PasswordReset {
  id            Int      @id @default(autoincrement())
  email         String
  whmcsClientId Int
  whmcsUserId   Int
  token         String   @unique
  expiresAt     DateTime
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("password_resets")
}

// ================= DIDIT SESSION MODULE =================
model DiditSession {
  id Int @id @default(autoincrement())

  /// The Didit-assigned session UUID (e.g. "11111111-2222-3333-4444-555555555555")
  sessionId     String  @unique
  /// Short sequential number returned by Didit
  sessionNumber Int?
  /// Opaque token used to build the verification URL
  sessionToken  String?

  /// The URL sent to the user for completing verification
  verificationUrl String?

  /// Freeform string you passed as vendor_data (e.g. onboardingId, userId)
  vendorData String?

  /// One of: "Not Started" | "Pending" | "In Review" | "Approved" | "Declined"
  status String @default("Not Started")

  // ── Relations ────────────────────────────────────────────────────────────
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kycProfileId Int?
  kycProfile   KycProfile? @relation(fields: [kycProfileId], references: [id], onDelete: SetNull)

  // ── Extracted document data ───────────────────────────────────────────────
  documentType   String?
  documentNumber String?
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  nationality    String?

  // ── Extracted / auto-filled address ──────────────────────────────────────
  addressStreet     String?
  addressStreet2    String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  // ── Raw API payload (stored for audit / re-processing) ───────────────────
  rawSessionResponse  Json?
  rawDecisionResponse Json?

  // ── Timestamps ───────────────────────────────────────────────────────────
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([kycProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("didit_sessions")
}

// ================= EMAIL TEMPLATE MODULE =================
model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  subject     String
  body        String   @db.Text
  status      String   @default("1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

// ================= EMAIL LOG MODULE =================
model EmailLog {
  id        Int      @id @default(autoincrement())
  template  String?
  recipient String
  subject   String
  status    String   // "sent" | "failed"
  errorMessage String? @db.Text
  sentAt    DateTime @default(now())

  @@index([recipient])
  @@index([status])
  @@index([sentAt])
  @@map("email_logs")
}

// ================= ADMIN ACTIVITY LOG MODULE =================
model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  logAction  String
  logMessage String
  rawData    Json?
  userId     Int?
  username   String?
  adminId    Int?
  adminName  String?
  ipAddress  String?
  userAgent  String?
  device     String?
  browser    String?
  createdAt  DateTime @default(now())

  @@map("admin_activity_logs")
}

// ================= USER ACTIVITY LOG MODULE =================
model UserActivityLog {
  id         Int      @id @default(autoincrement())
  logAction  String
  logMessage String
  rawData    Json?
  userId     Int?
  username   String?
  email      String?
  ipAddress  String?
  userAgent  String?
  device     String?
  browser    String?
  status     String   @default("success") // "success" | "failed"
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([logAction])
  @@index([email])
  @@index([createdAt])
  @@map("user_activity_logs")
}

model ServiceMapping {
  id         String   @id @default(uuid())
  serviceId  String   // WHMCS service ID
  userId     String
  createdAt  DateTime @default(now())

  @@unique([serviceId, userId])
  @@index([userId])

  @@map("service_mappings")
}

model InvoiceMapping {
  id         String   @id @default(uuid())
  invoiceId  String   // WHMCS invoice ID
  userId     String
  createdAt  DateTime @default(now())

  @@unique([invoiceId, userId])
  @@index([userId])

  @@map("invoice_mappings")
}

model TwoFactorMethod {
  id            String   @id @default(cuid())

  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          TwoFactorType

  enabled       Boolean  @default(false)

  secret        String?
  email         String?
  phoneNumber   String?

  isPrimary     Boolean  @default(false)

  verifiedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, type])

  @@map("two_factor_methods")
}